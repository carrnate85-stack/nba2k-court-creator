<Window x:Class="NBA2KCourtCreator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:NBA2KCourtCreator.Models"
        Title="NBA 2K Court Creator" Width="1500" Height="920" MinWidth="1080" MinHeight="700"
        WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <HierarchicalDataTemplate DataType="{x:Type models:CourtLayerNode}" ItemsSource="{Binding Children}">
      <Grid Height="28" MinWidth="460">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="54" />
          <ColumnDefinition Width="28" />
          <ColumnDefinition Width="76" />
          <ColumnDefinition Width="52" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        <TextBlock Grid.Column="1" Text="{Binding VisibilityText}" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
        <Border Grid.Column="2" Width="18" Height="18" VerticalAlignment="Center" HorizontalAlignment="Center" Background="{Binding SwatchBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" />
        <TextBlock Grid.Column="3" Text="{Binding ActiveHex}" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
        <TextBlock Grid.Column="4" Text="{Binding OpacityLabel}" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}" />
      </Grid>
    </HierarchicalDataTemplate>
  </Window.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="226" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <Border Grid.Column="0" Background="{StaticResource SidebarBrush}">
      <DockPanel>
        <Border DockPanel.Dock="Top" Padding="20,20,16,18" BorderBrush="#34444A" BorderThickness="0,0,0,1">
          <StackPanel>
            <TextBlock Text="NBA 2K" Foreground="#58C9BA" FontWeight="Bold" FontSize="12" />
            <TextBlock Text="Court Creator" Foreground="White" FontWeight="SemiBold" FontSize="20" Margin="0,2,0,0" />
            <TextBlock Text="Companion workspace" Foreground="#83959A" FontSize="11" Margin="0,3,0,0" />
          </StackPanel>
        </Border>

        <StackPanel DockPanel.Dock="Bottom" Margin="12,8,12,14">
          <TextBlock Text="WPF + Python engine" Foreground="#71848A" FontSize="10" Margin="10,2" />
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="0,10,0,10">
            <RadioButton Style="{StaticResource NavButton}" Content="Court Workspace" IsChecked="True" />
            <RadioButton Style="{StaticResource NavButton}" Content="Floors" />
            <RadioButton Style="{StaticResource NavButton}" Content="Paint &amp; Lines" />
            <RadioButton Style="{StaticResource NavButton}" Content="Team Colors" />
            <RadioButton Style="{StaticResource NavButton}" Content="Presets" />
            <RadioButton Style="{StaticResource NavButton}" Content="Export" />
          </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="76" />
        <RowDefinition Height="*" />
        <RowDefinition Height="28" />
      </Grid.RowDefinitions>

      <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="18,12">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="120" />
            <ColumnDefinition Width="150" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center">
            <TextBlock x:Name="ProjectNameText" Text="NBA 2K Court Creator" FontWeight="SemiBold" FontSize="15" TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="ProjectStateText" Text="Starting workspace..." Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,3,0,0" />
          </StackPanel>
          <StackPanel Grid.Column="1" Margin="10,0,8,0">
            <TextBlock Text="Game" Foreground="{StaticResource MutedBrush}" FontSize="10" />
            <ComboBox SelectedIndex="0">
              <ComboBoxItem Content="NBA 2K25" />
              <ComboBoxItem Content="NBA 2K26" />
            </ComboBox>
          </StackPanel>
          <StackPanel Grid.Column="2" Margin="0,0,10,0">
            <TextBlock Text="Template" Foreground="{StaticResource MutedBrush}" FontSize="10" />
            <ComboBox x:Name="TemplatePicker" SelectedIndex="0">
              <ComboBoxItem Content="RedLite2K Court" />
            </ComboBox>
          </StackPanel>
          <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
            <Button Content="New" Click="OnResetDefault" />
            <Button Content="Open" Click="OnLoadState" />
            <Button Content="Save" Click="OnSaveState" />
            <Button Content="Open PSD" Click="OnOpenPsd" />
            <Button Content="Export PNG" Click="OnExportPng" />
            <Button Style="{StaticResource PrimaryButton}" Content="Reset Default" Click="OnResetDefault" />
          </StackPanel>
        </Grid>
      </Border>

      <Grid Grid.Row="1" Margin="18,14,18,16">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel>
          <TextBlock Text="Court Workspace" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" />
          <TextBlock Text="Build the court layout, choose one floor, tune paint and line colors, then export the preview." Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0" />
        </StackPanel>
        <Grid Grid.Row="1" Margin="0,14,0,14">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Button Grid.Column="0" Style="{StaticResource PrimaryButton}" Content="Load Court PSD" Click="OnLoadPsd" Padding="12,8" />
          <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="Add Custom Floor" Click="OnAddCustomFloor" Padding="12,8" />
          <Button Grid.Column="2" Style="{StaticResource PrimaryButton}" Content="Refresh Preview" Click="OnRefreshPreview" Padding="12,8" />
          <Button Grid.Column="3" Style="{StaticResource PrimaryButton}" Content="Export PNG" Click="OnExportPng" Padding="12,8" Margin="0" />
        </Grid>

        <Grid Grid.Row="2">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="480" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="260" />
          </Grid.RowDefinitions>

          <GroupBox Header="Court Layers">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="26" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <Grid Grid.Row="0" Margin="27,0,11,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="54" />
                  <ColumnDefinition Width="28" />
                  <ColumnDefinition Width="76" />
                  <ColumnDefinition Width="52" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Layer" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" />
                <TextBlock Grid.Column="1" Text="Visible" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="" />
                <TextBlock Grid.Column="3" Text="Hex" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" />
                <TextBlock Grid.Column="4" Text="Opacity" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right" />
              </Grid>
              <TreeView x:Name="LayersTree"
                        Grid.Row="1"
                        ItemsSource="{Binding LayerRoots}"
                        SelectedItemChanged="OnLayerSelected"
                        MouseDoubleClick="OnLayerDoubleClick"
                        PreviewMouseRightButtonDown="OnLayerRightClick"
                        VirtualizingStackPanel.IsVirtualizing="True">
                <TreeView.ContextMenu>
                  <ContextMenu>
                    <MenuItem Header="Rename" Click="OnRenameLayer" />
                    <MenuItem Header="Remove Custom Floor" Click="OnRemoveCustomFloor" />
                  </ContextMenu>
                </TreeView.ContextMenu>
              </TreeView>
            </Grid>
          </GroupBox>

          <GroupBox Grid.Row="1" Header="Selected Layer">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <TextBlock x:Name="SelectedLayerText" Text="No layer selected." FontWeight="SemiBold" TextWrapping="Wrap" />
              <Grid Grid.Row="1" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="28" />
                  <ColumnDefinition Width="90" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <CheckBox x:Name="VisibleCheck" Content="Visible" VerticalAlignment="Center" Checked="OnVisibleChecked" Unchecked="OnVisibleChecked" />
                <Border x:Name="SelectedColorBox" Grid.Column="1" Width="18" Height="18" Margin="8,0,0,0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" />
                <TextBox x:Name="HexBox" Grid.Column="2" Margin="6,0,0,0" Text="#FFFFFF" KeyDown="OnHexKeyDown" />
                <Button Grid.Column="3" Content="Apply" Margin="6,0,0,0" Click="OnApplyHex" />
                <Button Grid.Column="4" Content="Pick" Click="OnPickColor" />
                <Button Grid.Column="5" Content="Reset" Click="OnResetColor" />
                <Button Grid.Column="6" Content="Add Floor" Click="OnAddCustomFloor" />
              </Grid>
            </Grid>
          </GroupBox>

          <GroupBox Grid.Row="2" Header="Team Colors">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <TextBox x:Name="PaletteSearchBox" TextChanged="OnPaletteSearchChanged" Margin="0,0,0,8" />
              <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="PaletteHost" />
              </ScrollViewer>
            </Grid>
          </GroupBox>
        </Grid>

        <Grid Grid.Column="2">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="10" Margin="0,0,0,10">
            <UniformGrid x:Name="PresetHost" Rows="1" Columns="5" />
          </Border>

          <Border Grid.Row="1" Background="#20242B" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <Grid>
              <Image x:Name="PreviewImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
              <TextBlock x:Name="PreviewEmptyText"
                         Text="Loading court preview..."
                         Foreground="#D8DDE8"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         FontSize="16" />
            </Grid>
          </Border>
        </Grid>
        </Grid>
      </Grid>

      <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="10,5">
        <Grid>
          <TextBlock x:Name="StatusText" Text="Starting workspace..." Foreground="{StaticResource MutedBrush}" FontSize="11" />
          <TextBlock Text="v1.0.0 WPF" HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}" FontSize="11" />
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>
