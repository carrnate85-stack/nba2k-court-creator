<Window x:Class="NBA2KCourtCreator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:NBA2KCourtCreator.Models"
        Title="NBA 2K Court Creator" Width="1760" Height="920" MinWidth="1720" MinHeight="720"
        WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <HierarchicalDataTemplate DataType="{x:Type models:CourtLayerNode}" ItemsSource="{Binding Children}">
      <Grid Height="30" MinWidth="420">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="300" />
        <TextBlock Grid.Column="1" Text="{Binding VisibilityText}" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Margin="10,0,0,0" FontWeight="SemiBold" />
        <StackPanel Grid.Column="2"
                    Orientation="Horizontal"
                    VerticalAlignment="Center"
                    Margin="10,0,0,0"
                    Visibility="{Binding ShowInlineColorControls, Converter={StaticResource BoolToVisibility}}">
          <Button Width="24"
                  Height="24"
                  Padding="0"
                  Margin="0,0,6,0"
                  Tag="{Binding}"
                  Click="OnInlineColorPick">
            <Border Width="16" Height="16" Background="{Binding SwatchBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" />
          </Button>
          <TextBox Width="82"
                   MinHeight="24"
                   Padding="5,2"
                   Text="{Binding ActiveHex, Mode=OneWay}"
                   Tag="{Binding}"
                   GotKeyboardFocus="OnInlineHexGotKeyboardFocus"
                   KeyDown="OnInlineHexKeyDown"
                   LostFocus="OnInlineHexLostFocus" />
        </StackPanel>
      </Grid>
    </HierarchicalDataTemplate>
  </Window.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="226" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <Border Grid.Column="0" Background="{StaticResource SidebarBrush}">
      <DockPanel>
        <Border DockPanel.Dock="Top" Padding="20,20,16,18" BorderBrush="#34444A" BorderThickness="0,0,0,1">
          <StackPanel>
            <TextBlock Text="NBA 2K" Foreground="#58C9BA" FontWeight="Bold" FontSize="12" />
            <TextBlock Text="Court Creator" Foreground="White" FontWeight="SemiBold" FontSize="20" Margin="0,2,0,0" />
            <TextBlock Text="Companion workspace" Foreground="#83959A" FontSize="11" Margin="0,3,0,0" />
          </StackPanel>
        </Border>

        <StackPanel DockPanel.Dock="Bottom" Margin="12,8,12,14">
          <TextBlock Text="WPF + Python engine" Foreground="#71848A" FontSize="10" Margin="10,2" />
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="0,10,0,10">
            <RadioButton x:Name="FloorsNav" Style="{StaticResource NavButton}" Content="Court Floors" Tag="floors" IsChecked="True" Checked="OnSectionChanged" />
            <RadioButton x:Name="PaintNav" Style="{StaticResource NavButton}" Content="Paint &amp; Lines" Tag="paint" Checked="OnSectionChanged" />
            <RadioButton x:Name="LogosNav" Style="{StaticResource NavButton}" Content="Logos" Tag="logos" Checked="OnSectionChanged" />
            <RadioButton x:Name="ExportNav" Style="{StaticResource NavButton}" Content="Export" Tag="export" Checked="OnSectionChanged" />
          </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="76" />
        <RowDefinition Height="*" />
        <RowDefinition Height="28" />
      </Grid.RowDefinitions>

      <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="18,12">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="420" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center">
            <TextBlock x:Name="ProjectNameText" Text="NBA 2K Court Creator" FontWeight="SemiBold" FontSize="15" TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="ProjectStateText" Text="Starting workspace..." Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,3,0,0" />
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
            <Button Content="New" Click="OnResetDefault" />
            <Button Content="Open" Click="OnLoadState" />
            <Button Content="Save" Click="OnSaveState" />
            <Button Content="Open PSD" Click="OnOpenPsd" />
            <Button Content="Export PNG" Click="OnExportPng" />
            <Button Style="{StaticResource PrimaryButton}" Content="Reset Default" Click="OnResetDefault" />
          </StackPanel>
        </Grid>
      </Border>

      <Grid Grid.Row="1" Margin="18,14,18,16">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel>
          <TextBlock x:Name="WorkspaceTitle" Text="Court Floors" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" />
          <TextBlock x:Name="WorkspaceSubtitle" Text="Choose one court floor at a time, including custom and NBA 2K26 templates." Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0" />
        </StackPanel>
        <Grid x:Name="FloorActions" Grid.Row="1" Margin="0,14,0,14" Visibility="Collapsed">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Button Grid.Column="0" Style="{StaticResource PrimaryButton}" Content="Load Court PSD" Click="OnLoadPsd" Padding="12,8" />
          <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="Add Custom Floor" Click="OnAddCustomFloor" Padding="12,8" />
          <Button Grid.Column="2" Style="{StaticResource PrimaryButton}" Content="Remove Custom Floor" Click="OnRemoveCustomFloor" Padding="12,8" />
          <Button Grid.Column="3" Style="{StaticResource PrimaryButton}" Content="Export PNG" Click="OnExportPng" Padding="12,8" Margin="0" />
        </Grid>
        <Grid x:Name="ExportActions" Grid.Row="1" Margin="0,14,0,14" Visibility="Collapsed">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Button Grid.Column="0" Style="{StaticResource PrimaryButton}" Content="Refresh Preview" Click="OnRefreshPreview" Padding="12,8" />
          <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="Export PNG" Click="OnExportPng" Padding="12,8" />
          <Button Grid.Column="2" Content="Save State" Click="OnSaveState" Padding="12,8" />
          <Button Grid.Column="3" Content="Open PSD" Click="OnOpenPsd" Padding="12,8" Margin="0" />
        </Grid>

        <Grid Grid.Row="2">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="940" />
            <ColumnDefinition Width="14" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
          <Grid.RowDefinitions>
            <RowDefinition Height="470" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <Border Background="#20242B" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" MouseLeftButtonUp="OnPreviewClicked" Cursor="Hand" Margin="0,0,0,8">
            <Grid>
              <Image x:Name="PreviewImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
              <TextBlock x:Name="PreviewEmptyText"
                         Text="Loading court preview..."
                         Foreground="#D8DDE8"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         FontSize="13" />
            </Grid>
          </Border>

          <GroupBox x:Name="SelectedLayerPanel" Grid.Row="1" Header="Selected">
            <Grid>
              <TextBlock x:Name="SelectedLayerText" Text="Court: No court selected." FontWeight="SemiBold" TextWrapping="Wrap" />
              <Grid Visibility="Collapsed">
                <CheckBox x:Name="VisibleCheck" Checked="OnVisibleChecked" Unchecked="OnVisibleChecked" />
                <Border x:Name="SelectedColorBox" />
                <TextBox x:Name="HexBox" KeyDown="OnHexKeyDown" />
              </Grid>
            </Grid>
          </GroupBox>

          <GroupBox x:Name="PalettePanel" Grid.Row="2" Header="Team Colors" Visibility="Collapsed">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <TextBox x:Name="PaletteSearchBox" TextChanged="OnPaletteSearchChanged" Margin="0,0,0,8" />
              <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="PaletteHost" />
              </ScrollViewer>
            </Grid>
          </GroupBox>
          <GroupBox x:Name="PresetPanel" Grid.Row="2" Header="Presets" Visibility="Collapsed">
            <StackPanel>
              <UniformGrid x:Name="PresetSectionHost" Rows="5" Columns="1" />
            </StackPanel>
          </GroupBox>
          <GroupBox x:Name="ExportPanel" Grid.Row="2" Header="Export" Visibility="Collapsed">
            <StackPanel>
              <Button Style="{StaticResource PrimaryButton}" Content="Refresh Preview" Click="OnRefreshPreview" Padding="12,8" Margin="0,0,0,8" />
              <Button Style="{StaticResource PrimaryButton}" Content="Export PNG" Click="OnExportPng" Padding="12,8" Margin="0,0,0,8" />
              <Button Content="Save State" Click="OnSaveState" Padding="12,8" Margin="0,0,0,8" />
              <Button Content="Open Court PSD" Click="OnOpenPsd" Padding="12,8" Margin="0" />
            </StackPanel>
          </GroupBox>
        </Grid>

        <Grid Grid.Column="2">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="500" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <Border x:Name="PresetStrip" Grid.Column="0" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="10" Margin="0,0,0,10" Visibility="Collapsed">
            <UniformGrid x:Name="PresetHost" Rows="1" Columns="5" />
          </Border>

          <GroupBox x:Name="LayerPanel" Grid.Row="1" Grid.Column="0" Header="Court Floors" Margin="0">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <TextBox x:Name="FloorSearchBox" Grid.Row="0" TextChanged="OnFloorSearchChanged" Margin="0,0,0,8" />
              <TreeView x:Name="LayersTree"
                        Grid.Row="1"
                        ItemsSource="{Binding SectionLayerRoots}"
                        SelectedItemChanged="OnLayerSelected"
                        MouseDoubleClick="OnLayerDoubleClick"
                        PreviewMouseRightButtonDown="OnLayerRightClick"
                        VirtualizingStackPanel.IsVirtualizing="True">
                <TreeView.Resources>
                  <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#DCEDE9" />
                  <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#DCEDE9" />
                  <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#182329" />
                </TreeView.Resources>
                <TreeView.ContextMenu>
                  <ContextMenu>
                    <MenuItem Header="Rename" Click="OnRenameLayer" />
                    <MenuItem Header="Remove Custom Floor" Click="OnRemoveCustomFloor" />
                  </ContextMenu>
                </TreeView.ContextMenu>
              </TreeView>
            </Grid>
          </GroupBox>

          <GroupBox x:Name="LogoPanel" Grid.Row="1" Grid.Column="0" Header="Logos" Margin="0" Visibility="Collapsed">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>

              <Button Grid.Row="0" Style="{StaticResource PrimaryButton}" Content="Import Logo" Click="OnImportLogo" Padding="12,8" Margin="0,0,0,8" />

              <ListBox x:Name="LogosList"
                       Grid.Row="1"
                       ItemsSource="{Binding LogoImages}"
                       DisplayMemberPath="Name"
                       SelectionChanged="OnLogoSelected" />

              <Grid Grid.Row="2" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="80" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="12" />
                  <ColumnDefinition Width="80" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <CheckBox x:Name="LogoVisibleCheck" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Content="Visible" Checked="OnLogoControlChanged" Unchecked="OnLogoControlChanged" Margin="0,0,0,8" />
                <Button x:Name="RemoveLogoButton" Grid.Row="0" Grid.Column="3" Grid.ColumnSpan="2" Content="Remove" Click="OnRemoveLogo" Margin="0,0,0,8" />

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Left" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
                <TextBox x:Name="LogoXBox" Grid.Row="1" Grid.Column="1" KeyDown="OnLogoTextKeyDown" LostFocus="OnLogoControlLostFocus" />
                <TextBlock Grid.Row="1" Grid.Column="3" Text="Top" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
                <TextBox x:Name="LogoYBox" Grid.Row="1" Grid.Column="4" KeyDown="OnLogoTextKeyDown" LostFocus="OnLogoControlLostFocus" />

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Size" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0" />
                <TextBox x:Name="LogoWidthBox" Grid.Row="2" Grid.Column="1" KeyDown="OnLogoTextKeyDown" LostFocus="OnLogoControlLostFocus" Margin="0,8,0,0" />
                <TextBlock Grid.Row="2" Grid.Column="3" Text="Turn" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0" />
                <TextBox x:Name="LogoRotationBox" Grid.Row="2" Grid.Column="4" KeyDown="OnLogoTextKeyDown" LostFocus="OnLogoControlLostFocus" Margin="0,8,0,0" />

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Opacity" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0" />
                <TextBox x:Name="LogoOpacityBox" Grid.Row="3" Grid.Column="1" KeyDown="OnLogoTextKeyDown" LostFocus="OnLogoControlLostFocus" Margin="0,8,0,0" />
              </Grid>
            </Grid>
          </GroupBox>
        </Grid>
        </Grid>
      </Grid>

      <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="10,5">
        <Grid>
          <TextBlock x:Name="StatusText" Text="Starting workspace..." Foreground="{StaticResource MutedBrush}" FontSize="11" />
          <TextBlock Text="v1.0.0 WPF" HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}" FontSize="11" />
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>
