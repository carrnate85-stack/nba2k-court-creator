<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<Style x:Key="KeyboardFocusVisual" TargetType="Control" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"><Setter Property="Template"><Setter.Value><ControlTemplate><Rectangle Margin="2" Stroke="{DynamicResource AccentBrightBrush}" StrokeThickness="1" StrokeDashArray="2,2" RadiusX="4" RadiusY="4" /></ControlTemplate></Setter.Value></Setter></Style>
<Style TargetType="Button" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"><Setter Property="Background" Value="{DynamicResource PanelRaisedBrush}" /><Setter Property="Foreground" Value="{DynamicResource TextBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="Padding" Value="12,8" /><Setter Property="Margin" Value="3" /><Setter Property="Cursor" Value="Hand" /><Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusVisual}" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Grid><Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><Border x:Name="HoverOverlay" Background="#16FFFFFF" CornerRadius="6" Opacity="0" IsHitTestVisible="False" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" /></Grid><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="HoverOverlay" Property="Opacity" Value="1" /><Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource StrongBorderBrush}" /></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.78" /></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.38" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
<Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"><Setter Property="Width" Value="38" /><Setter Property="Height" Value="38" /><Setter Property="Padding" Value="8" /><Setter Property="Margin" Value="3" /></Style>
<Style x:Key="ToolButton" TargetType="Button" BasedOn="{StaticResource IconButton}" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"><Setter Property="Width" Value="42" /><Setter Property="Height" Value="42" /><Setter Property="Margin" Value="3,1" /><Setter Property="Padding" Value="9" /><Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="Transparent" /><Setter Property="ToolTipService.InitialShowDelay" Value="300" /><Setter Property="ToolTipService.ShowDuration" Value="10000" /></Style>
<Style x:Key="CanvasActionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"><Setter Property="Width" Value="32" /><Setter Property="Height" Value="32" /><Setter Property="Padding" Value="7" /><Setter Property="Margin" Value="2,0" /><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="ActionChrome" CornerRadius="6" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ActionChrome" Property="Background" Value="{DynamicResource PanelHoverBrush}" /></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="ActionChrome" Property="Background" Value="{DynamicResource AccentDarkBrush}" /></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
<Style x:Key="ColorSwatchButton" TargetType="Button" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"><Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0" /><Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="Transparent" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Grid><Ellipse x:Name="SwatchHalo" Fill="{TemplateBinding Background}" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1" /><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /></Grid><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="SwatchHalo" Property="Stroke" Value="{DynamicResource AccentBrightBrush}" /></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="SwatchHalo" Property="Stroke" Value="{DynamicResource AccentBrightBrush}" /></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>

<Style x:Key="MenuPopupBorderStyle" TargetType="Border" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"><Setter Property="Background" Value="{DynamicResource MenuPopupBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource StrongBorderBrush}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="7" /><Setter Property="MinWidth" Value="284" /><Setter Property="MaxHeight" Value="560" /><Setter Property="SnapsToDevicePixels" Value="True" /><Setter Property="Effect"><Setter.Value><DropShadowEffect Color="#000000" BlurRadius="16" ShadowDepth="4" Opacity="0.18" /></Setter.Value></Setter></Style>
<ControlTemplate x:Key="StudioTopLevelMenuItemTemplate" TargetType="MenuItem" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"><Grid SnapsToDevicePixels="True"><Border x:Name="HeaderBorder" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1" CornerRadius="5" Padding="{TemplateBinding Padding}"><ContentPresenter ContentSource="Header" RecognizesAccessKey="True" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><Popup x:Name="PART_Popup" Placement="Bottom" PlacementTarget="{Binding ElementName=HeaderBorder}" VerticalOffset="3" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade" IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"><Border Style="{StaticResource MenuPopupBorderStyle}"><ScrollViewer CanContentScroll="True" Focusable="False" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Grid Grid.IsSharedSizeScope="True"><ItemsPresenter x:Name="ItemsPresenter" Margin="4" KeyboardNavigation.DirectionalNavigation="Cycle" KeyboardNavigation.TabNavigation="Cycle" /></Grid></ScrollViewer></Border></Popup></Grid><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="HeaderBorder" Property="Background" Value="{DynamicResource MenuHoverBrush}" /></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="HeaderBorder" Property="BorderBrush" Value="{DynamicResource StrongBorderBrush}" /></Trigger><Trigger Property="IsSubmenuOpen" Value="True"><Setter TargetName="HeaderBorder" Property="Background" Value="{DynamicResource MenuOpenBrush}" /><Setter TargetName="HeaderBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.38" /></Trigger></ControlTemplate.Triggers></ControlTemplate>
<ControlTemplate x:Key="StudioSubmenuMenuItemTemplate" TargetType="MenuItem" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"><Grid SnapsToDevicePixels="True"><Border x:Name="ItemBorder" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}" MinHeight="34"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28" SharedSizeGroup="MenuIconColumn" /><ColumnDefinition Width="*" MinWidth="148" /><ColumnDefinition Width="Auto" SharedSizeGroup="MenuGestureColumn" /><ColumnDefinition Width="20" SharedSizeGroup="MenuArrowColumn" /></Grid.ColumnDefinitions><Grid Grid.Column="0" Width="18" Height="18" HorizontalAlignment="Left"><ContentPresenter x:Name="IconHost" ContentSource="Icon" HorizontalAlignment="Center" VerticalAlignment="Center" /><Path x:Name="CheckGlyph" Visibility="Collapsed" Data="M 1,8 L 6,13 L 16,2" Stroke="{DynamicResource AccentBrightBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" /></Grid><ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center" Margin="0,0,16,0" /><TextBlock x:Name="GestureText" Grid.Column="2" Text="{TemplateBinding InputGestureText}" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="18,0,12,0" /><Path x:Name="SubmenuArrow" Grid.Column="3" Data="M 1,1 L 5,5 L 1,9" Stroke="{DynamicResource MutedTextBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center" VerticalAlignment="Center" /></Grid></Border><Popup x:Name="PART_Popup" Placement="Right" PlacementTarget="{Binding ElementName=ItemBorder}" HorizontalOffset="-2" VerticalOffset="-5" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade" IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"><Border Style="{StaticResource MenuPopupBorderStyle}"><ScrollViewer CanContentScroll="True" Focusable="False" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Grid Grid.IsSharedSizeScope="True"><ItemsPresenter x:Name="ItemsPresenter" Margin="4" KeyboardNavigation.DirectionalNavigation="Cycle" KeyboardNavigation.TabNavigation="Cycle" /></Grid></ScrollViewer></Border></Popup></Grid><ControlTemplate.Triggers><Trigger Property="HasItems" Value="False"><Setter TargetName="SubmenuArrow" Property="Visibility" Value="Collapsed" /></Trigger><Trigger Property="IsChecked" Value="True"><Setter TargetName="IconHost" Property="Visibility" Value="Collapsed" /><Setter TargetName="CheckGlyph" Property="Visibility" Value="Visible" /></Trigger><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource MenuHoverBrush}" /><Setter TargetName="GestureText" Property="Foreground" Value="{DynamicResource TextBrush}" /><Setter TargetName="SubmenuArrow" Property="Stroke" Value="{DynamicResource TextBrush}" /></Trigger><Trigger Property="IsSubmenuOpen" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource MenuOpenBrush}" /><Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource AccentDarkBrush}" /></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.38" /></Trigger></ControlTemplate.Triggers></ControlTemplate>
<Style TargetType="Menu" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"><Setter Property="Background" Value="Transparent" /><Setter Property="Foreground" Value="{DynamicResource TextBrush}" /><Setter Property="KeyboardNavigation.DirectionalNavigation" Value="Cycle" /><Setter Property="KeyboardNavigation.TabNavigation" Value="Cycle" /></Style>
<Style TargetType="MenuItem" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"><Setter Property="Background" Value="Transparent" /><Setter Property="Foreground" Value="{DynamicResource TextBrush}" /><Setter Property="Padding" Value="10,7" /><Setter Property="FocusVisualStyle" Value="{x:Null}" /><Setter Property="Template" Value="{StaticResource StudioSubmenuMenuItemTemplate}" /><Style.Triggers><Trigger Property="Role" Value="TopLevelHeader"><Setter Property="Padding" Value="12,9" /><Setter Property="Template" Value="{StaticResource StudioTopLevelMenuItemTemplate}" /></Trigger><Trigger Property="Role" Value="TopLevelItem"><Setter Property="Padding" Value="12,9" /><Setter Property="Template" Value="{StaticResource StudioTopLevelMenuItemTemplate}" /></Trigger></Style.Triggers></Style>
<Style TargetType="Separator" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"><Setter Property="Height" Value="11" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Separator"><Border Height="1" Margin="38,5,12,5" Background="{DynamicResource MenuSeparatorBrush}" VerticalAlignment="Center" SnapsToDevicePixels="True" /></ControlTemplate></Setter.Value></Setter></Style>
</ResourceDictionary>
