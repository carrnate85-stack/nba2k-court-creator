<Window x:Class="NBA2KCourtCreator.Studio.StudioWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:canvas="clr-namespace:TextureStudio;assembly=Canvas.Wpf" xmlns:studio="clr-namespace:TwoK.Studio;assembly=TwoK.Studio" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
 Title="2K Court Creator" Width="1440" Height="900" MinWidth="1000" MinHeight="680" WindowStyle="None" ResizeMode="CanResize"
 Icon="/NBA2KCourtCreator;component/Assets/app-icon.ico" WindowStartupLocation="CenterScreen">
 <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/></shell:WindowChrome.WindowChrome>
 <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="StudioStyles.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
 <Border BorderBrush="{DynamicResource StrongBorderBrush}" BorderThickness="1" Background="{DynamicResource WindowBrush}">
 <Grid><Grid.RowDefinitions><RowDefinition Height="36"/><RowDefinition Height="36"/><RowDefinition Height="*"/><RowDefinition Height="26"/></Grid.RowDefinitions>
  <Border x:Name="TopChrome" Background="{DynamicResource TopChromeBrush}" BorderBrush="{DynamicResource ChromeDividerBrush}" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBarMouseDown">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="22,0,0,0"><Border Width="24" Height="24" Background="{DynamicResource ActionBrush}" CornerRadius="5" Margin="0,0,10,0"><TextBlock Text="2K" Foreground="White" FontStyle="Italic" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Court Creator" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel>
    <Menu x:Name="ApplicationMenu" Grid.Column="1" Background="Transparent" VerticalAlignment="Center"><MenuItem Header="_File"><MenuItem Header="_New court" InputGestureText="Ctrl+N" Click="NewClick"/><MenuItem Header="_Open project..." InputGestureText="Ctrl+O" Click="OpenClick"/><MenuItem x:Name="SaveMenuItem" Header="_Save project" InputGestureText="Ctrl+S" Click="SaveClick"/><MenuItem x:Name="SaveAsMenuItem" Header="Save project _as..." ToolTip="Save a separate project copy (Ctrl+Shift+S)" Click="SaveAsClick"/><Separator/><MenuItem Header="Import older court..." Click="ImportSectionClick"/><MenuItem Header="Refresh court" Click="RefreshClick"/></MenuItem><MenuItem Header="_Edit"><MenuItem x:Name="UndoMenuItem" Header="_Undo" InputGestureText="Ctrl+Z" Click="UndoClick"/><MenuItem x:Name="RedoMenuItem" Header="_Redo" InputGestureText="Ctrl+Y" ToolTip="Redo (Ctrl+Y or Ctrl+Shift+Z)" Click="RedoClick"/></MenuItem><MenuItem Header="_View"><MenuItem Header="Fit court" InputGestureText="Ctrl+0" Click="FitClick"/><MenuItem Header="Switch light / dark appearance" Click="ThemeClick"/></MenuItem></Menu>
    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
     <Button x:Name="SaveToolbarButton" Style="{StaticResource QuietButton}" Content="Save" ToolTip="Save project (Ctrl+S)" Click="SaveClick" Padding="8,5" Margin="2,0"/>
     <Button x:Name="ExportTopButton" Style="{StaticResource StudioAction}" Click="ExportMenuClick" Padding="16,5" Margin="8,0,12,0" ToolTip="Export PNG, NBA 2K27 IFF, or send to 2K Canvas"><StackPanel Orientation="Horizontal"><TextBlock Text="Export" Foreground="{DynamicResource ActionTextBrush}"/><Path Stroke="{DynamicResource ActionTextBrush}" StrokeThickness="1.4" Data="M0,0 L4,4 L8,0" Width="8" Height="5" Margin="10,0,0,0" VerticalAlignment="Center"/></StackPanel><Button.ContextMenu><ContextMenu><MenuItem Header="Export Texture PNG..." Click="ExportPngClick"/><MenuItem Header="Build NBA 2K27 IFF..." Click="ExportIffClick"/><MenuItem Header="Send Texture to 2K Canvas" Click="SendCanvasClick"/><Separator/><MenuItem Header="Export settings" Click="ExportSectionClick"/></ContextMenu></Button.ContextMenu></Button>
     <Button Style="{StaticResource WindowControlButton}" Click="MinimizeClick" ToolTip="Minimize"><Path Stroke="{DynamicResource TextBrush}" StrokeThickness="1.7" Data="M3,14 H15" Width="18" Height="18"/></Button><Button x:Name="MaximizeButton" Style="{StaticResource WindowControlButton}" Click="MaximizeClick" ToolTip="Maximize" AutomationProperties.Name="Maximize"><Viewbox Width="18" Height="18"><Path x:Name="MaximizeGlyph" Stroke="{DynamicResource TextBrush}" StrokeThickness="1.5" Data="M3,3 H15 V15 H3 Z"/></Viewbox></Button><Button Style="{StaticResource WindowControlButton}" Click="CloseClick" ToolTip="Close"><Path Stroke="{DynamicResource TextBrush}" StrokeThickness="1.7" Data="M3,3 L15,15 M15,3 L3,15" Width="18" Height="18"/></Button>
    </StackPanel>
   </Grid>
  </Border>
  <Border x:Name="DocumentChrome" Grid.Row="1" Background="{DynamicResource DocumentChromeBrush}" BorderBrush="{DynamicResource ChromeDividerBrush}" BorderThickness="0,0,0,1"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/><ColumnDefinition Width="0"/></Grid.ColumnDefinitions>
   <Grid Grid.Column="1" x:Name="PreviewToolbar" Margin="0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="HeaderInspectorWidth" Width="{Binding Width,ElementName=InspectorWidth}"/></Grid.ColumnDefinitions>
    <StackPanel x:Name="ViewControls" Orientation="Horizontal" VerticalAlignment="Bottom"><Border Background="{DynamicResource PanelRaisedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,1,1,0" CornerRadius="9,9,0,0" Padding="6,0" Height="32" Width="190"><Grid><Button x:Name="ProjectTitleButton" Style="{StaticResource QuietButton}" Click="RenameProjectClick" ToolTip="Rename project" HorizontalContentAlignment="Left" Padding="6,3" Margin="0"><StackPanel Orientation="Horizontal"><Path Stroke="{DynamicResource MutedTextBrush}" StrokeThickness="1" Data="M2,1 H8 L12,5 V15 H2 Z M8,1 V5 H12" Width="14" Height="16" Margin="0,0,8,0"/><TextBlock x:Name="ProjectText" Text="Untitled court" FontSize="12" MaxWidth="138" TextTrimming="CharacterEllipsis"/></StackPanel></Button><TextBox x:Name="ProjectNameInput" Visibility="Collapsed" FontSize="12" Padding="6,4" MaxLength="120" KeyDown="ProjectNameKeyDown" LostKeyboardFocus="ProjectNameLostFocus"/></Grid></Border></StackPanel>
    <StackPanel x:Name="ZoomControls" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Height="32" Margin="0"><Button x:Name="ImportButton" Visibility="Collapsed" Tag="import" Click="SectionClick"/><Button x:Name="ExportButton" Visibility="Collapsed" Tag="export" Click="SectionClick"/>
     <Button x:Name="FullViewButton" Visibility="Collapsed" Tag="full" Click="ViewClick"/>
     <Button Style="{StaticResource CanvasActionButton}" ToolTip="Fit on screen (Ctrl+0)" AutomationProperties.Name="Fit on screen" Click="FitClick"><Viewbox Width="17" Height="17"><Path Stroke="{DynamicResource TextBrush}" StrokeThickness="1.5" Data="M5,1 H1 V5 M11,1 H15 V5 M1,11 V15 H5 M15,11 V15 H11 M4,4 H12 V12 H4 Z"/></Viewbox></Button>
     <Button x:Name="ZoomMenuButton" Height="32" Padding="8,5" Margin="2,0" Background="Transparent" BorderThickness="0" Click="ZoomMenuClick" ToolTip="Zoom options" AutomationProperties.Name="Zoom options"><Button.ContextMenu><ContextMenu Placement="Bottom"><MenuItem Header="Fit on screen" InputGestureText="Ctrl+0" Click="FitClick"/><MenuItem Header="100% — actual pixels" InputGestureText="Ctrl+1" Click="ActualSizeClick"/><Separator/><MenuItem Header="Zoom in" InputGestureText="Ctrl++" Click="ZoomInClick"/><MenuItem Header="Zoom out" InputGestureText="Ctrl+-" Click="ZoomOutClick"/><Separator/><MenuItem Header="Full Court" Tag="full" Click="ViewClick"/><MenuItem Header="Left Half" Tag="left" Click="ViewClick"/><MenuItem Header="Right Half" Tag="right" Click="ViewClick"/></ContextMenu></Button.ContextMenu><StackPanel Orientation="Horizontal"><TextBlock x:Name="ZoomText" Text="Fit" MinWidth="37" TextAlignment="Center"/><Path Stroke="{DynamicResource MutedTextBrush}" StrokeThickness="1.3" Data="M0,0 L4,4 L8,0" Width="8" Height="5" Margin="8,0,0,0" VerticalAlignment="Center"/></StackPanel></Button>
     <Button Style="{StaticResource CanvasActionButton}" Tag="Hand" Click="ToolClick" ToolTip="Hand tool (H) – hold Space or middle mouse to pan"><studio:ToolIcon Mode="Hand" Width="19" Height="19"/></Button><Border Width="1" Height="22" Background="{DynamicResource BorderBrush}" Margin="10,0"/>
     <Button x:Name="UndoToolbarButton" Style="{StaticResource CanvasActionButton}" ToolTip="Undo (Ctrl+Z)" AutomationProperties.Name="Undo" Click="UndoClick"><Viewbox Width="17" Height="17"><Path Stroke="{DynamicResource TextBrush}" StrokeThickness="1.5" StrokeLineJoin="Round" Data="M17,14 C17,8 13,5 8,5 H3 M3,5 L7,1 M3,5 L7,9"/></Viewbox></Button><Button x:Name="RedoToolbarButton" Style="{StaticResource CanvasActionButton}" ToolTip="Redo (Ctrl+Y)" AutomationProperties.Name="Redo" Click="RedoClick"><Viewbox Width="17" Height="17"><Path Stroke="{DynamicResource TextBrush}" StrokeThickness="1.5" StrokeLineJoin="Round" Data="M3,14 C3,8 7,5 12,5 H17 M17,5 L13,1 M17,5 L13,9"/></Viewbox></Button>
    </StackPanel>
   </Grid>
  </Grid></Border>
  <Grid x:Name="WorkspaceRoot" Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="72"/><ColumnDefinition Width="*"/><ColumnDefinition x:Name="InspectorGap" Width="0"/><ColumnDefinition x:Name="InspectorWidth" Width="400"/></Grid.ColumnDefinitions>
   <Border Background="{DynamicResource PanelBrush}"><Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="2,6">
    <Button x:Name="HardwoodToolButton" Style="{StaticResource ToolButton}" Click="HardwoodToolClick" ToolTip="Adjust hardwood texture" AutomationProperties.Name="Hardwood texture tool"><Viewbox Width="22" Height="22"><Path Stroke="{DynamicResource TextBrush}" StrokeThickness="1.5" Data="M3,3 H21 V21 H3 Z M3,9 H21 M3,15 H21 M9,3 V9 M15,9 V15 M8,15 V21"/></Viewbox></Button>
    <Button x:Name="MoveToolButton" Style="{StaticResource ToolButton}" Tag="Move" Click="ToolClick" ToolTip="Move tool &#x2022; V&#x0a;Select and drag a logo; corner handles resize, top handle rotates" AutomationProperties.Name="Move tool"><studio:ToolIcon Mode="Move"/></Button>
    <Button x:Name="TransformToolButton" Style="{StaticResource ToolButton}" Tag="Transform" Click="ToolClick" ToolTip="Resize / rotate logo &#x2022; Ctrl+T&#x0a;Drag corner handles to resize, top handle to rotate" AutomationProperties.Name="Resize and rotate logo"><Viewbox Width="22" Height="22"><Path Stroke="{DynamicResource TextBrush}" StrokeThickness="1.5" StrokeLineJoin="Round" Data="M5,5 H19 V19 H5 Z M3,3 H7 V7 H3 Z M17,3 H21 V7 H17 Z M3,17 H7 V21 H3 Z M17,17 H21 V21 H17 Z"/></Viewbox></Button>
    <Button x:Name="EyedropperToolButton" Style="{StaticResource ToolButton}" Tag="Eyedropper" Click="ToolClick" ToolTip="Eyedropper tool &#x2022; I&#x0a;Click court artwork to color the selected paint or line layer" AutomationProperties.Name="Eyedropper tool"><studio:ToolIcon Mode="Eyedropper"/></Button>
    <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="14,8"/>
    <Button x:Name="HandToolButton" Style="{StaticResource ToolButton}" Tag="Hand" Click="ToolClick" ToolTip="Hand tool &#x2022; H &#x2022; hold Space temporarily" AutomationProperties.Name="Hand tool"><studio:ToolIcon Mode="Hand"/></Button>
    <Button x:Name="ZoomToolButton" Style="{StaticResource ToolButton}" Tag="Zoom" Click="ToolClick" ToolTip="Zoom tool &#x2022; Z (Alt-click zooms out)" AutomationProperties.Name="Zoom tool"><studio:ToolIcon Mode="Zoom"/></Button>
   </StackPanel></ScrollViewer><StackPanel x:Name="PinnedTools" Grid.Row="1" Margin="7,8,7,8" HorizontalAlignment="Center"><Button x:Name="PinnedColorButton" Style="{StaticResource ColorSwatchButton}" Width="32" Height="32" Click="PickSelectedColorClick" ToolTip="Choose selected court layer color"><Border x:Name="PinnedColorSwatch" Width="28" Height="28" Background="#19583F" BorderBrush="{DynamicResource StrongBorderBrush}" BorderThickness="1" CornerRadius="14"/></Button><Button x:Name="ThemeToolbarButton" Style="{StaticResource CanvasActionButton}" ToolTip="Switch light / dark appearance" Click="ThemeClick" Margin="0,2,0,0" Padding="6"><Viewbox Width="19" Height="19"><Path Stroke="{DynamicResource TextBrush}" StrokeThickness="1.5" Data="M14,2 A9,9 0 1 0 22,14 A8,8 0 0 1 14,2 Z"/></Viewbox></Button></StackPanel></Grid></Border>
   <Border x:Name="ViewportCard" Grid.Column="1" Background="{DynamicResource WorkspaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" ClipToBounds="True" Margin="12"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid MinHeight="42"><DockPanel x:Name="PreviewContextLabel" Margin="12,8"><TextBlock x:Name="ActiveToolText" Visibility="Collapsed"/><TextBlock Text="GAME UV" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" HorizontalAlignment="Right"/></DockPanel>
     <Border x:Name="TransformOptionsBar" Visibility="Collapsed" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="10,5"><StackPanel x:Name="LogoProperties" Orientation="Horizontal" VerticalAlignment="Center"/></Border>
     <Border x:Name="HardwoodOptionsPanel" Visibility="Collapsed" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
      <DockPanel>
       <Button x:Name="HardwoodResetButton" DockPanel.Dock="Right" Style="{StaticResource CanvasActionButton}" Width="28" Height="28" Margin="6,6,6,0" Padding="5" VerticalAlignment="Top" Click="ResetHardwoodTextureClick" ToolTip="Reset the selected hardwood texture" AutomationProperties.Name="Reset hardwood texture">
        <Viewbox Width="17" Height="17"><Path Stroke="{DynamicResource TextBrush}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M3,11 A9,9 0 1 1 12,20 M3,4 V11 H10"/></Viewbox>
       </Button>
       <ScrollViewer x:Name="HardwoodOptionsScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" CanContentScroll="False"><canvas:ContextualToolOptionsBar x:Name="HardwoodOptions" Visibility="Collapsed"/></ScrollViewer>
      </DockPanel>
     </Border>
    </Grid><studio:ArtworkCanvas x:Name="CourtCanvas" Grid.Row="1"/><TextBlock x:Name="CanvasHint" Grid.Row="2" Text="Scroll to zoom &#x2022; Space + drag to pan" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" HorizontalAlignment="Center" Margin="12,10,12,16"/></Grid></Border>
   <Grid Grid.Column="3" Margin="10,8,10,8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="8"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <StackPanel>
    <Button x:Name="SelectedCourtCard" Style="{StaticResource CourtCardButton}" Padding="10" Click="CatalogClick" ToolTip="Browse and change the selected hardwood" AutomationProperties.Name="Selected hardwood: open catalog"><Grid IsHitTestVisible="False"><Grid.ColumnDefinitions><ColumnDefinition Width="80"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Background="{DynamicResource WorkspaceBrush}" Width="76" Height="42" CornerRadius="3"><Image x:Name="FloorThumbnail" Width="74" Height="40" Stretch="Uniform"/></Border><StackPanel Grid.Column="1" Margin="8,0,4,0"><TextBlock Text="SELECTED HARDWOOD" FontSize="9" Foreground="{DynamicResource MutedTextBrush}"/><TextBlock x:Name="SelectedCourtText" Text="Loading court library..." FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,4,0,2"/><TextBlock Text="NBA 2K27" FontSize="10" Foreground="{DynamicResource MutedTextBrush}"/></StackPanel><Path Grid.Column="2" Stroke="{DynamicResource TextBrush}" StrokeThickness="1.5" Data="M4,2 L10,8 L4,14" Width="14" Height="16" Margin="8,0,4,0" VerticalAlignment="Center"/></Grid></Button>
    </StackPanel>
<Border x:Name="Inspector" Grid.Row="2" Style="{StaticResource StudioPanel}" Padding="12,10,12,12"><DockPanel><UniformGrid x:Name="InspectorTabs" DockPanel.Dock="Top" Columns="2" Margin="0,0,0,10"><Button x:Name="PaintButton" Style="{StaticResource StudioNav}" Tag="paint" Click="SectionClick" ToolTip="Colors &amp; Lines"><StackPanel Orientation="Horizontal"><Viewbox Width="18" Height="18" Margin="0,0,7,0"><Path Width="24" Height="24" Stroke="{DynamicResource TextBrush}" StrokeThickness="1.6" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M5,4 H15 L20,14 L13,21 L3,11 Z M5,4 L13,14 H20 M7,7 L11,11"/></Viewbox><TextBlock Text="Colors &amp; Lines" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel></Button><Button x:Name="LogosButton" Style="{StaticResource StudioNav}" Tag="logos" Click="SectionClick" ToolTip="Logos"><StackPanel Orientation="Horizontal"><Viewbox Width="18" Height="18" Margin="0,0,7,0"><Path Width="24" Height="24" Stroke="{DynamicResource TextBrush}" StrokeThickness="1.6" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M4,4 H20 V20 H4 Z M7,16 L11,11 L14,14 L17,8 M8,8 H8.1"/></Viewbox><TextBlock Text="Logos" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel></Button></UniformGrid>
        <Grid>
          <Grid x:Name="PaintPanel" Visibility="Collapsed"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="LayersHost"/></ScrollViewer></Grid>
          <Grid x:Name="LogoPanel" Visibility="Collapsed"><ScrollViewer x:Name="LogoPropertiesScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>

            <DockPanel><TextBlock Text="Opacity" FontSize="14" FontWeight="SemiBold"/><TextBlock x:Name="LogoOpacityValue" Text="100%" HorizontalAlignment="Right" Foreground="{DynamicResource MutedTextBrush}"/></DockPanel>
            <Slider x:Name="LogoOpacitySlider" Style="{StaticResource CanvasLayerSlider}" Minimum="0" Maximum="100" Value="100" IsEnabled="False" AutomationProperties.Name="Selected logo opacity" PreviewMouseLeftButtonDown="LogoOpacityStart" PreviewMouseLeftButtonUp="LogoOpacityEnd" LostMouseCapture="LogoOpacityEnd" PreviewKeyDown="LogoOpacityKeyDown" PreviewKeyUp="LogoOpacityKeyUp" LostKeyboardFocus="LogoOpacityEnd" ValueChanged="LogoOpacityChanged"/>
            <DockPanel Margin="0,6,0,4"><TextBlock Text="Image Layers" FontSize="14" FontWeight="SemiBold"/><TextBlock x:Name="LogoLayerCount" Text="0 layers" FontSize="12" HorizontalAlignment="Right" Foreground="{DynamicResource MutedTextBrush}"/></DockPanel>
            <ListBox x:Name="LogoList" Style="{StaticResource CanvasLogoList}" Height="224" Margin="0,0,0,8" Padding="0" SelectionChanged="LogoSelectionChanged" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                                <Setter Property="Padding" Value="6,4" />
                                                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="LayerRow" Background="{DynamicResource PanelRaisedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Margin="3,1" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="LayerRow" Property="Background" Value="{DynamicResource PanelHoverBrush}" /></Trigger>
                                                        <Trigger Property="IsSelected" Value="True"><Setter TargetName="LayerRow" Property="Background" Value="{DynamicResource AccentDarkBrush}" /><Setter TargetName="LayerRow" Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate></Setter.Value></Setter>
                                            </Style>
                                        </ListBox.ItemContainerStyle><ListBox.ItemTemplate><DataTemplate><Grid MinHeight="40"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <CheckBox IsChecked="{Binding Visible,Mode=OneWay}" Tag="{Binding}" Click="LogoVisibilityClick" Width="26" Height="30" Margin="0,0,5,0" ToolTip="Show / hide layer" AutomationProperties.Name="Layer visibility"><CheckBox.Template><ControlTemplate TargetType="CheckBox"><Border Background="Transparent" Padding="3"><Path x:Name="Eye" Stroke="{DynamicResource TextBrush}" StrokeThickness="1.4" Stretch="Uniform" Data="M1,8 C5,1 13,1 17,8 C13,15 5,15 1,8 Z M6,8 A3,3 0 1 0 12,8 A3,3 0 1 0 6,8"/></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="False"><Setter TargetName="Eye" Property="Opacity" Value="0.2"/></Trigger></ControlTemplate.Triggers></ControlTemplate></CheckBox.Template></CheckBox>
              <Border Grid.Column="1" Width="40" Height="40" Padding="1" Background="{DynamicResource CheckerBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="3"><Image Source="{Binding Image}" Stretch="Uniform"/></Border><TextBox Grid.Column="2" Text="{Binding Name,Mode=OneWay}" Tag="{Binding}" FontSize="13" Padding="4,3" BorderThickness="0" Background="Transparent" VerticalAlignment="Center" MinWidth="0" ToolTip="Rename logo (Enter applies, Escape cancels)" GotKeyboardFocus="LogoNameFocus" KeyDown="LogoNameKeyDown" LostKeyboardFocus="LogoNameLostFocus"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
            <Button x:Name="ImportLogoButton" Content="+ Add Image" Style="{StaticResource StudioAction}" MinHeight="32" Padding="4,6" Margin="3,0,3,3" ToolTip="Import and clean up a logo image (four slots maximum)" Click="ImportLogoClick"/>
            <Grid x:Name="LogoActions" Margin="0,0,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="0.95*"/><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="30"/><ColumnDefinition Width="30"/></Grid.ColumnDefinitions>
              <Button x:Name="FlipLogoButton" Style="{StaticResource CanvasLogoAction}" Click="LogoActionMenuClick" ToolTip="Flip selected logo in place" AutomationProperties.Name="Flip logo options">
                <StackPanel Orientation="Horizontal"><TextBlock Text="Flip"/><Path Stroke="{DynamicResource TextBrush}" StrokeThickness="1.3" Data="M0,0 L3,3 L6,0" Width="6" Height="3" Margin="6,0,0,0" VerticalAlignment="Center"/></StackPanel>
                <Button.ContextMenu><ContextMenu><MenuItem x:Name="FlipXMenu" Header="Flip X" Click="FlipXClick" ToolTip="Flip artwork left/right without moving it"/><MenuItem x:Name="FlipYMenu" Header="Flip Y" Click="FlipYClick" ToolTip="Flip artwork top/bottom without moving it"/></ContextMenu></Button.ContextMenu>
              </Button>
              <Button x:Name="MirrorLogoButton" Grid.Column="1" Style="{StaticResource CanvasLogoAction}" Click="LogoActionMenuClick" ToolTip="Copy selected logo to the opposite side of the court" AutomationProperties.Name="Mirror logo options">
                <StackPanel Orientation="Horizontal"><TextBlock Text="Mirror"/><Path Stroke="{DynamicResource TextBrush}" StrokeThickness="1.3" Data="M0,0 L3,3 L6,0" Width="6" Height="3" Margin="6,0,0,0" VerticalAlignment="Center"/></StackPanel>
                <Button.ContextMenu><ContextMenu><MenuItem x:Name="CopyXMenu" Header="Mirror X" Click="CopyXClick" ToolTip="Copy left/right across court center; keep artwork orientation"/><MenuItem x:Name="CopyYMenu" Header="Mirror Y" Click="CopyYClick" ToolTip="Copy top/bottom across court center; keep artwork orientation"/></ContextMenu></Button.ContextMenu>
              </Button>
              <Button x:Name="DuplicateLogoButton" Grid.Column="2" Style="{StaticResource CanvasLogoAction}" Click="DuplicateLogoClick" ToolTip="Duplicate selected logo (four slots maximum)" AutomationProperties.Name="Copy selected logo"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8C8;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" Margin="0,0,4,0" VerticalAlignment="Center"/><TextBlock Text="Copy" VerticalAlignment="Center"/></StackPanel></Button>
              <Button x:Name="DeleteLogoButton" Grid.Column="3" Style="{StaticResource CanvasLogoAction}" Click="DeleteLogoClick" ToolTip="Delete selected logo" AutomationProperties.Name="Delete selected logo"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE74D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" Margin="0,0,4,0" VerticalAlignment="Center"/><TextBlock Text="Delete" VerticalAlignment="Center"/></StackPanel></Button>
              <Button x:Name="MoveLogoUpButton" Grid.Column="4" Style="{StaticResource CanvasLogoAction}" Padding="2,3" Click="BackwardClick" ToolTip="Move layer up in list (toward back)" AutomationProperties.Name="Move logo layer up"><TextBlock Text="&#x2191;" FontSize="18"/></Button>
              <Button x:Name="MoveLogoDownButton" Grid.Column="5" Style="{StaticResource CanvasLogoAction}" Padding="2,3" Click="ForwardClick" ToolTip="Move layer down in list (toward front)" AutomationProperties.Name="Move logo layer down"><TextBlock Text="&#x2193;" FontSize="18"/></Button>
            </Grid>
          </StackPanel></ScrollViewer></Grid>
          <Grid x:Name="ImportPanel" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <DockPanel><TextBlock Text="Convert Court" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/><Button Content="Open IFF" Click="ImportSourceClick" HorizontalAlignment="Right"/></DockPanel>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,12,0,0">
              <TextBlock x:Name="ImportSourceText" Text="No source court selected" TextWrapping="Wrap" Margin="0,0,0,8"/>
              <ComboBox x:Name="ImportTextures" SelectionChanged="ImportTextureChanged" Margin="0,0,0,8"/>
              <TextBlock Text="Playable court edges" FontWeight="SemiBold" Margin="0,8"/><UniformGrid x:Name="ImportBoundsHost" Columns="2"/>
              <Button Content="Reset detected edges" Click="ResetImportBoundsClick" Margin="0,8"/>
              <Button Content="Refresh conversion preview" Click="RefreshImportClick" Margin="0,0,0,8"/>
              <Button x:Name="ConvertIffButton" Style="{StaticResource StudioAction}" Content="Build NBA 2K27 IFF" Click="ConvertIffClick" Margin="0,0,0,8"/>
              <Button x:Name="ConvertPngButton" Content="Export converted PNG" Click="ConvertPngClick" Margin="0,0,0,8"/>
              <TextBlock x:Name="ImportInfoText" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap"/>
            </StackPanel></ScrollViewer>
          </Grid>
