<Window x:Class="NBA2KCourtCreator.Studio.LogoImportWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:studio="clr-namespace:TwoK.Studio;assembly=TwoK.Studio"
 Title="Import Logo" Width="980" Height="660" MinWidth="780" MinHeight="520" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
 <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="StudioStyles.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
 <Grid Margin="14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,12,0"><TextBlock Text="Import Logo" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="SourceText" Text="Choose an image to preview and clean before placement." Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/></StackPanel><Button x:Name="ChooseImageButton" Grid.Column="1" Content="Choose Image..." Click="ChooseClick" Style="{StaticResource InspectorAction}" Padding="12,4" Margin="0" VerticalAlignment="Center"/></Grid>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
   <Border x:Name="PreviewHost" Background="{DynamicResource CheckerBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" ClipToBounds="True"><Grid><Image x:Name="PreviewImage" Stretch="Uniform" MouseLeftButtonDown="PreviewClick"/><TextBlock x:Name="EmptyHint" Text="PNG, JPEG, BMP, GIF, or TIFF" Foreground="{DynamicResource MutedTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid></Border>
   <Border Grid.Column="2" Style="{StaticResource StudioPanel}" Padding="12"><ScrollViewer x:Name="CleanupScroll" Padding="0,0,6,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="CleanupControls" IsEnabled="False">
    <TextBlock Text="Local logo cleanup" Style="{StaticResource InspectorHeading}"/>
    <TextBlock Text="Remove solid colors. Original file stays unchanged." Foreground="{DynamicResource MutedTextBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,6"/>
    <StackPanel Orientation="Horizontal"><Button x:Name="InspectButton" Style="{StaticResource ToolButton}" Click="InspectClick" ToolTip="Eyedropper: click to sample a background color" Background="{DynamicResource AccentDarkBrush}"><studio:ToolIcon Mode="Eyedropper"/></Button><Button x:Name="WandButton" Style="{StaticResource ToolButton}" Click="WandClick" ToolTip="Magic Wand: click to remove a connected color area, including enclosed holes"><studio:ToolIcon Mode="MagicWand"/></Button><TextBlock x:Name="ModeText" Text="Sample color" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0"/></StackPanel>
    <TextBlock x:Name="ToolHint" Text="Click the preview to sample the background color." TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Margin="0,5,0,6"/>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Tolerance" FontSize="11"/><TextBlock x:Name="ToleranceText" Grid.Column="1" Text="20" MinWidth="26" TextAlignment="Right" FontSize="11"/></Grid><Slider x:Name="ToleranceSlider" Minimum="0" Maximum="255" Value="20" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="ToleranceChanged" Margin="0,3,0,1"/><TextBlock Text="0: exact color · 255: all opaque colors" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" TextWrapping="Wrap"/>
    <CheckBox x:Name="AllMatchingCheck" Content="Remove all matching colors" Margin="0,6,0,6" ToolTip="Explicitly remove the clicked color everywhere, including separate logo elements"/>
    <StackPanel Orientation="Horizontal" Margin="0,0,0,6"><Border x:Name="BackgroundSwatch" Width="22" Height="22" Background="White" BorderBrush="{DynamicResource StrongBorderBrush}" BorderThickness="1" CornerRadius="3"/><TextBlock x:Name="BackgroundHex" Text="#FFFFFF" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0"/></StackPanel>
    <Button x:Name="RemoveBackgroundButton" Content="Remove edge background" Click="RemoveBackgroundClick" Style="{StaticResource InspectorAction}" Margin="0" ToolTip="Remove edge-connected color. Use the wand for enclosed holes."/>
    <UniformGrid Columns="2" Margin="0,6,0,0"><Button x:Name="CleanupUndoButton" Content="Undo" Click="UndoClick" Style="{StaticResource InspectorAction}" IsEnabled="False"/><Button x:Name="ResetButton" Content="Reset" Click="ResetClick" Style="{StaticResource InspectorAction}" IsEnabled="False"/></UniformGrid>
    <TextBlock x:Name="CleanupStatus" Text="Existing transparency is preserved." TextWrapping="Wrap" FontSize="10" Foreground="{DynamicResource MutedTextBrush}" Margin="0,5,0,0"/>
   </StackPanel></ScrollViewer></Border>
  </Grid>
  <Grid Grid.Row="2" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Move, resize and rotate after placement." TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" Margin="0,0,18,0"/><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="Cancel" IsCancel="True" Style="{StaticResource InspectorAction}" Width="84" Margin="0,0,8,0"/><Button x:Name="PlaceButton" Content="Place on Court" Style="{StaticResource StudioAction}" Height="32" Padding="12,4" Margin="0" IsEnabled="False" Click="PlaceClick"/></StackPanel></Grid>
 </Grid>
</Window>
